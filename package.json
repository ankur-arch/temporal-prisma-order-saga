{
  "name": "temporal-prisma-order-saga",
  "version": "0.1.0",
  "private": true,
  "description": "Order fulfilment saga with Temporal, Prisma ORM and Prisma Postgres: idempotent activities and compensation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate",
    "db:seed": "tsx src/scripts/seed.ts",
    "worker": "tsx src/worker.ts",
    "order": "tsx src/scripts/start-order.ts",
    "orders": "tsx src/scripts/list-orders.ts",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/cli-engine": "0.9.0",
    "@temporalio/testing": "^1.25.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prisma": "8.0.0-rc.33",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
